GEMINI_API_KEY=your_api_key_here
# Change this whenever you want to use another Gemini model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Required only for approved draft PR creation through GitHub MCP.
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_here
# Optional override for a compatible GitHub MCP endpoint.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# auto tries Gemini, then Groq, and falls back to local Ollama.
CODE_AGENT_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# Optional LangSmith trace viewer.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
